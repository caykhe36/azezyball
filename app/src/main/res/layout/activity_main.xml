<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cartoon_sky"
    tools:context=".MainActivity">

    <!-- 3D OpenGL ES Cartoon Game Surface -->
    <com.azezy.azezyball.view.SoccerGLSurfaceView
        android:id="@+id/glSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top HUD Container -->
    <LinearLayout
        android:id="@+id/topHudContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="32dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header Row: Title & Action Buttons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="#40000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="⭐ AZEZY BALL 3D"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#40000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="Cự ly: 10.5m"
                    android:textColor="@color/gold_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Sound Button -->
                <ImageButton
                    android:id="@+id/btnSound"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Âm thanh"
                    android:elevation="4dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_volume_up" />

                <!-- Keeper Mode Toggle -->
                <ImageButton
                    android:id="@+id/btnKeeper"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Thủ môn"
                    android:elevation="4dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_keeper" />

                <!-- Control Mode Toggle -->
                <ImageButton
                    android:id="@+id/btnMode"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Chế độ sút"
                    android:elevation="4dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_swipe" />

                <!-- Help Button -->
                <ImageButton
                    android:id="@+id/btnHelp"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Hướng dẫn"
                    android:elevation="4dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_help" />

                <!-- Reset Score Button -->
                <ImageButton
                    android:id="@+id/btnReset"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Làm mới"
                    android:elevation="4dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_refresh" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Stats Dashboard Card (Bright Cartoon Style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_panel"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:padding="12dp"
            android:weightSum="3">

            <!-- Score -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚽ ĐIỂM"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="@color/cartoon_orange"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1.5dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="4dp"
                android:background="#E2E8F0" />

            <!-- Streak -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 CHUỖI"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="x0"
                    android:textColor="@color/cartoon_green"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1.5dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="4dp"
                android:background="#E2E8F0" />

            <!-- Best Score -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 KỶ LỤC"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBestScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="@color/cartoon_purple"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Celebration Banner (Comic / Cartoon Popup) -->
    <LinearLayout
        android:id="@+id/celebrationBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_celebration_banner"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="36dp"
        android:paddingVertical="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35">

        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:shadowColor="#66000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:text="💥 VÀO! GOAL!"
            android:textColor="@color/white"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvBannerSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="+150 ĐIỂM (COMBO x2)"
            android:textColor="@color/gold_light"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Bottom Hint Card -->
    <LinearLayout
        android:id="@+id/bottomHintCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_hud_panel"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvControlHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="👉 Vuốt thẳng lên để sút bóng vào gôn!"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
