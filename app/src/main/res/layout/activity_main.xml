<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cartoon_sky"
    tools:context=".MainActivity">

    <!-- 3D Ultra Smooth Cartoon Soccer Canvas Game Surface -->
    <com.azezy.azezyball.view.SoccerCanvasView
        android:id="@+id/soccerCanvasView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Spacious 2-Row Floating Top HUD Container (Never overlapping on any screen) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ROW 1: Brand & Action Controls (Sound, Settings) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Brand Watermark Chip -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_hud_panel"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="★ AZEZY.COM"
                    android:textColor="@color/cartoon_orange"
                    android:textSize="13sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Action Buttons: Large & Never Clipped -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnSound"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Âm thanh"
                    android:elevation="6dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_volume_up" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Cài đặt &amp; Tùy chọn"
                    android:elevation="6dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </LinearLayout>

        <!-- ROW 2: Hero Gameplay Dashboard (Streak & Score Badges) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Left: Hero Big Streak Badge (Số lần vào liên tiếp) -->
            <LinearLayout
                android:id="@+id/llStreakCard"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_hud_streak"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="x0"
                    android:textColor="@color/white"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="LIÊN TIẾP"
                    android:textColor="#FEF08A"
                    android:textSize="11sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Right: Score & Distance Pill -->
            <LinearLayout
                android:id="@+id/llScoreCard"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_hud_panel"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="⚽ 0"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp" />

                <View
                    android:layout_width="1.5dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="#CBD5E1" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="🎯 10.5m"
                    android:textColor="@color/cartoon_orange"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Celebration Banner Overlay (Ultra High-Contrast Comic Popup with Big Streak) -->
    <LinearLayout
        android:id="@+id/celebrationBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_banner_goal"
        android:elevation="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="36dp"
        android:paddingVertical="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.28">

        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:shadowColor="#FF000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="10"
            android:text="🔥 3 BÀN LIÊN TIẾP!"
            android:textColor="#FDE047"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/tvBannerSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:shadowColor="#FF000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:text="+300 ĐIỂM (COMBO x2)"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Bottom Hint Card (Auto-hides after 5s or on touch) -->
    <LinearLayout
        android:id="@+id/bottomHintCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_hud_panel"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvControlHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="👉 Vuốt thẳng lên để sút bóng vào gôn!"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
