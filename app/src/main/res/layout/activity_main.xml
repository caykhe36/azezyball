<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cartoon_sky"
    tools:context=".MainActivity">

    <!-- 3D Cartoon Soccer Canvas Game Surface -->
    <com.azezy.azezyball.view.SoccerCanvasView
        android:id="@+id/soccerCanvasView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Compact Floating Top Bar (Single Clean Row with Safe Spacing) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="52dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left: Floating Score & Streak Pill -->
        <LinearLayout
            android:id="@+id/llScoreCard"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_hud_panel"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-black"
                android:text="0"
                android:textColor="@color/cartoon_orange"
                android:textSize="18sp" />

            <View
                android:layout_width="1.5dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:background="#E2E8F0" />

            <TextView
                android:id="@+id/tvStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="🔥 x0"
                android:textColor="@color/cartoon_green"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Flexible Spacer to prevent overlapping on any screen size -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Center: Distance Chip -->
        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_hud_badge"
            android:elevation="4dp"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="🎯 10.5m"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <!-- Flexible Spacer -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Right: Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Sound Button -->
            <ImageButton
                android:id="@+id/btnSound"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Âm thanh"
                android:elevation="6dp"
                android:padding="9dp"
                android:src="@drawable/ic_volume_up" />

            <!-- Settings Button -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Cài đặt &amp; Tùy chọn"
                android:elevation="6dp"
                android:padding="9dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- Celebration Banner Overlay (Ultra High-Contrast Comic Popup) -->
    <LinearLayout
        android:id="@+id/celebrationBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_banner_goal"
        android:elevation="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.30">

        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:shadowColor="#FF000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="8"
            android:text="💥 VÀO! GOAL!"
            android:textColor="#FDE047"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvBannerSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:shadowColor="#FF000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="+150 ĐIỂM (Cự ly 10.5m)"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Bottom Hint Card (Auto-hides after 5s or on touch) -->
    <LinearLayout
        android:id="@+id/bottomHintCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_hud_panel"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvControlHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="👉 Vuốt thẳng lên để sút bóng vào gôn!"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
